# ============================================================
# SSK Store - Apache Production Configuration (.htaccess)
# Shree Sahajanand Sahitya Kendra (Kalakunj Mandir, Surat)
# ============================================================

# 1. PREVENT DIRECTORY BROWSING
Options -Indexes

# 2. DEFAULT CHARSET
AddDefaultCharset UTF-8

# 3. BLOCK ACCESS TO SENSITIVE DIRECTORIES & REWRITE RULES
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|database|logs|tools|vendor|\.git)/ - [F,L,NC]

    # Dynamic SEO XML Sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Clean SEO Slugs (Backward-compatible with original query params)
    RewriteRule ^product/([a-zA-Z0-9_-]+)/?$ product.php?slug=$1 [L,QSA]
    RewriteRule ^page/([a-zA-Z0-9_-]+)/?$ pages.php?slug=$1 [L,QSA]
</IfModule>

# 4. BLOCK ACCESS TO SENSITIVE FILES & EXTENSIONS (Apache 2.4 with 2.2 fallback)
<FilesMatch "(^\.|\.(env|sql|sqlite|sqlite3|db|bak|config|log|md|sh|lock|json|dist))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically protect database, schema and backup files
<FilesMatch "(database\.sql|ssk_store\.sqlite|baps_store\.sqlite|.*\.sqlite.*|\.git)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. CUSTOM ERROR DOCUMENTS
ErrorDocument 404 /404.php

# 6. SECURITY HEADERS
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking / framing
    Header always set X-Frame-Options "SAMEORIGIN"

    # Strict Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # XSS Protection filter for older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Content Security Policy (allows self, inline scripts/styles for theme & Google Fonts)
    Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://fonts.gstatic.com https://wa.me https://api.whatsapp.com data: blob:;"
</IfModule>

# 7. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 8. BROWSER CACHING FOR STATIC ASSETS
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Media & Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # HTML & Dynamic Content (revalidate)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 9. SERVICE WORKER NO-CACHE DIRECTIVE (PWA-1 Requirement)
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </IfModule>
</Files>

